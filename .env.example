# Copy to .env (gitignored): cp .env.example .env
# Optional. Without a key every project uses its built-in fake AI.
# Tests always use the fakes, whatever is set here.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
